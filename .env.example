# Cloud providers (optional - if unset, AgyssyyGPT falls back to local Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local provider
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: append every completed chat to a JSONL dataset (for fine-tuning)
# AGYSYY_LOG=logs/chats.jsonl
